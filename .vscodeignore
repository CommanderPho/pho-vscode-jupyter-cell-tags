.vscode
# Pack production `dependencies` (notably `typescript` for live console).
# A blanket `node_modules` exclude dropped runtime deps from the VSIX and
# made activation fail with "Cannot find module 'typescript'".
node_modules/**
!node_modules/typescript/
!node_modules/typescript/**
# out/
tsconfig.json
webpack.config.js
esbuild.js
examples/
examples/notebooks/
.idea/
.kiro/

# Cursor / SpecStory
.cursor/
.specstory/
.cursorignore
.cursorindexingignore

# Dev / CI / tooling
.gitignore
.nvmrc
azure-pipeline.stable.yml
vscode-jupyter-cell-tags.code-workspace
desktop.ini
.editorconfig
.prettierrc.js
package-lock.json
FM-*.ico

# Internal / unpack leftovers
test-uri.js
.agents/
.github/
extension/

# TypeScript source (runtime uses out/ only). Keep the symbol analyzer script.
src/**/*.ts
src/**/*.js
src/**/*.map
src/**/*.md

# Compiled tests and source maps
**/*.map
**/*.test.js
out/**/test/**
