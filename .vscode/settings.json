{
    "files.exclude": {
        "**/__pycache__": true,
        "**/.classpath": true,
        "**/.factorypath": true,
        "**/.ipynb_checkpoints": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.spyproject": true,
        "**/.virtual_documents": true,
        "**/.vscode": false,
        "**/*.asv": true,
        "**/*desktop.ini": true,
        "**/.idea": true,
    },
    "specstory.cloudSync.enabled": "never",
    "actionButtons": {
        "commands": [
            {
                "name": "VS Code Dev",
                "color": "#99CCFF",
                "tooltip": "Open this workspace in regular VS Code for extension development",
                "command": "code --new-window \"${workspaceFolder}\\vscode-jupyter-cell-tags.code-workspace\"",
                "singleInstance": true
            }
        ],
        "defaultColor": "white",
        "reloadButton": "↻",
        "loadNpmCommands": false
    }
}
