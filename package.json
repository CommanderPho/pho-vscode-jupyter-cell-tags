{
	"name": "pho-vscode-jupyter-cell-tags",
	"displayName": "Pho Jupyter Cell Tags",
	"description": "Extended Jupyter Cell Tags support for VS Code",
	"version": "0.6.7",
	"publisher": "phohale",
	"preview": true,
	"icon": "icon.png",
	"galleryBanner": {
		"color": "#ffffff",
		"theme": "light"
	},
	"author": {
		"name": "Pho Hale + Microsoft Corporation"
	},
	"engines": {
		"vscode": "^1.98.0"
	},
	"categories": [
		"Notebooks"
	],
	"activationEvents": [
		"onStartupFinished",
		"onNotebook:jupyter-notebook",
		"onNotebook:pho-notebook",
		"onNotebookEditor:editor.selection",
		"onNotebookEditor:editor.onDidChangeActiveNotebookEditor",
		"onCommand:jupyter-cell-tags.removeTag",
		"onCommand:jupyter-cell-tags.addTag",
		"onCommand:jupyter-cell-tags.editTagsInJSON",
		"onCommand:jupyter-cell-tags.paramaterize",
		"onCommand:jupyter-cell-tags.executeRunGroup",
		"onCommand:jupyter-cell-tags.executeRunCell",
		"onCommand:extension.showAllNotebookTags",
		"onView:all-notebook-tags-view",
		"onCommand:jupyter-cell-tags.openNotebookCell",
		"onCommand:jupyter-cell-tags.refreshEntry",
		"onCommand:jupyter-cell-tags.runTag",
		"onCommand:jupyter-cell-tags.selectAllChildCells",
		"onCommand:jupyter-cell-tags.listExecutedNotebookCells",
		"onCommand:jupyter-cell-tags.selectAllCellsUnderTag",
		"onView:jumpbacks",
		"onCommand:jupyter-cell-tags.addJumpback",
		"onCommand:jupyter-cell-tags.removeJumpback",
		"onCommand:jupyter-cell-tags.openJumpback",
		"onCommand:jupyter-cell-tags.refreshJumpbacks",
		"onCommand:jupyter-cell-tags.showAllNotebookJumpbacks",
		"onView:custom-notebook-outline",
		"onCommand:jupyter-cell-tags.customOutline.selectCell",
		"onCommand:jupyter-cell-tags.customOutline.selectAllChildCells",
		"onCommand:jupyter-cell-tags.customOutline.deleteCellsUnderHeading",
		"onCommand:jupyter-cell-tags.showCustomNotebookOutline",
		"onCommand:jupyter-cell-tags.customOutline.filter",
		"onCommand:jupyter-cell-tags.customOutline.clearFilter",
		"onCommand:jupyter-cell-tags.showNavigationMenu",
		"onCommand:jupyter-cell-tags.navigateUpToPreviousErrorCell",
		"onCommand:jupyter-cell-tags.navigateDownToNextErrorCell",
		"onCommand:jupyter-cell-tags.toggleCellMetadataDisplay",
		"onCommand:jupyter-cell-tags.ringMeJupyter.toggleBell",
		"onCommand:notebook.cell.executeCellAndBelow",
		"onCommand:notebook.cell.executeCellsAbove",
		"onCommand:notebook.cell.execute",
		"onCommand:notebook.execute",
		"onCommand:jupyter.runCellAndAllBelow",
		"onCommand:jupyter.runPrecedentCells",
		"onCommand:jupyter.runDependentCells",
		"onCommand:jupyter-cell-tags.gitDiff.highlightChangedCells",
		"onCommand:jupyter-cell-tags.gitDiff.clearHighlights",
		"onCommand:jupyter-cell-tags.gitDiff.highlightChangedCellsVsHead",
		"onCommand:jupyter-cell-tags.exportExecutedCodeToPython"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/CommanderPho/vscode-jupyter-cell-tags"
	},
	"main": "./out/extension.js",
	"browser": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "Jupyter Cell Tags",
			"properties": {
				"jupyter-cell-tags.tagSortOrder": {
					"type": "string",
					"enum": [
						"alphabetical",
						"creation-date",
						"modification-date",
						"priority",
						"detected-datetimes"
					],
					"default": "alphabetical",
					"description": "Sort order for tags in the All Notebook Tags view"
				},
				"jupyter-cell-tags.enableErrorNavigation": {
					"type": "boolean",
					"default": false,
					"description": "Enable/disable the Previous/Next Error Cell navigation commands"
				},
				"jupyter-cell-tags.enableJumpbacks": {
					"type": "boolean",
					"default": false,
					"description": "Enable/disable the Jumpback functionality including commands and views"
				},
				"jupyter-cell-tags.debugPrint": {
					"type": "boolean",
					"default": false,
					"description": "Enable/disable the logging to the debug console"
				},
				"jupyter-cell-tags.showDebugExecutionMessages": {
					"type": "boolean",
					"default": false,
					"description": "Show debug message boxes for cell navigation and execution (e.g. 'Navigated to cell X', 'Executed cell X'). Useful for extension debugging; leave disabled for normal use."
				},
				"jupyter-cell-tags.outlineSync.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable automatic Outline pane synchronization with programmatic cell selections"
				},
				"jupyter-cell-tags.outlineSync.debounceMs": {
					"type": "number",
					"default": 100,
					"description": "Debounce delay in milliseconds for Outline synchronization"
				},
				"jupyter-cell-tags.customOutline.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable custom notebook outline view with multi-select support"
				},
				"jupyter-cell-tags.customOutline.updateDebounceMs": {
					"type": "number",
					"default": 200,
					"description": "Debounce delay in milliseconds for custom notebook outline updates"
				},
				"jupyter-cell-tags.customOutline.showCellIndices": {
					"type": "boolean",
					"default": false,
					"description": "Show cell indices in custom outline item labels"
				},
				"jupyter-cell-tags.customOutline.showExecutedCells": {
					"type": "boolean",
					"default": false,
					"description": "Show thin indicator lines in the outline for cells executed in this session."
				},
				"jupyter-cell-tags.customOutline.executedCellColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#FFFF0033",
					"description": "Color for the executed cell indicator lines in the custom notebook outline."
				},
				"jupyter-cell-tags.customOutline.headingIcons": {
					"type": "array",
					"description": "Codicon icon ids to use for heading levels 1-6 in the custom outline view",
					"default": [
						"symbol-class",
						"symbol-method",
						"symbol-property",
						"symbol-field",
						"symbol-variable",
						"symbol-constant"
					],
					"items": {
						"type": "string"
					}
				},
				"jupyter-cell-tags.ringMeJupyter.recipientEmail": {
					"type": "string",
					"default": "",
					"description": "Enter your email address to receive Jupyter execution notifications."
				},
				"jupyter-cell-tags.jupyterEnhancements.layout.enableCompactView": {
					"type": "boolean",
					"default": false,
					"description": "Enables a tight layout: Verbose timing, Line numbers ON, Small output font, Consolidated Run Button, etc."
				},
				"jupyter-cell-tags.jupyterEnhancements.kernel.optimizeStartup": {
					"type": "boolean",
					"default": true,
					"description": "Disables 'python.terminal.activateEnvironment' to significantly speed up startup when using Conda on Windows. (Default: True)"
				},
				"jupyter-cell-tags.jupyterEnhancements.kernel.pythonPath": {
					"type": "string",
					"default": "t:/PYTHON/envs/jlab/python.exe",
					"description": "Absolute path to the Python executable (e.g. C:/Anaconda3/python.exe). Forces this kernel on startup."
				},
				"jupyter-cell-tags.jupyterEnhancements.layout.hideCellToolbar": {
					"type": "boolean",
					"default": false,
					"description": "Hides the floating cell toolbar (Run/Delete/etc) when enabled. Shows it on the right when disabled."
				},
				"jupyter-cell-tags.jupyterEnhancements.general.flashDuration": {
					"type": "number",
					"default": 300,
					"description": "Duration of the flash effect in milliseconds."
				},
				"jupyter-cell-tags.jupyterEnhancements.background.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable persistent background colors (Green/Red) after execution."
				},
				"jupyter-cell-tags.jupyterEnhancements.background.successColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#90EE9033",
					"description": "Background color for successfully executed cells."
				},
				"jupyter-cell-tags.jupyterEnhancements.background.errorColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#FF000033",
					"description": "Background color for failed cells."
				},
				"jupyter-cell-tags.jupyterEnhancements.flash.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable a brief flash effect upon successful execution."
				},
				"jupyter-cell-tags.jupyterEnhancements.flash.color": {
					"type": "string",
					"format": "color-hex",
					"default": "#FFFF0066",
					"description": "Color of the flash effect."
				},
				"jupyter-cell-tags.jupyterEnhancements.innerBorder.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable a border around the code text (Command Box) while running."
				},
				"jupyter-cell-tags.jupyterEnhancements.innerBorder.persist": {
					"type": "boolean",
					"default": false,
					"description": "Keep the inner border (Dark Green) visible after success."
				},
				"jupyter-cell-tags.jupyterEnhancements.innerBorder.runningColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#0078FF",
					"description": "Color of the inner border while running (Blue)."
				},
				"jupyter-cell-tags.jupyterEnhancements.innerBorder.successColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#006400",
					"description": "Color of the inner border after success."
				},
				"jupyter-cell-tags.jupyterEnhancements.outerBorder.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable a thick indicator bar on the left side of the cell while running."
				},
				"jupyter-cell-tags.jupyterEnhancements.outerBorder.position": {
					"type": "string",
					"default": "left",
					"enum": [
						"left",
						"right",
						"top",
						"bottom"
					],
					"description": "Side where the thick indicator bar appears."
				},
				"jupyter-cell-tags.jupyterEnhancements.outerBorder.thickness": {
					"type": "string",
					"default": "10px",
					"description": "Thickness of the outer indicator bar (e.g., '2px', '8px', '12px')."
				},
				"jupyter-cell-tags.jupyterEnhancements.outerBorder.persist": {
					"type": "boolean",
					"default": true,
					"description": "Keep the outer indicator (Dark Green) visible after success."
				},
				"jupyter-cell-tags.jupyterEnhancements.outerBorder.runningColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#0078FF",
					"description": "Color of the outer indicator while running (Blue)."
				},
				"jupyter-cell-tags.jupyterEnhancements.outerBorder.successColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#006400",
					"description": "Color of the outer indicator after success."
				},
				"jupyter-cell-tags.jupyterEnhancements.scratchpad.borderColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#80808080",
					"description": "Border color for Scratchpad cells. (Default: F11)"
				},
				"jupyter-cell-tags.jupyterEnhancements.scratchpad.borderStyle": {
					"type": "string",
					"default": "dashed",
					"enum": [
						"solid",
						"dashed",
						"dotted",
						"double",
						"groove"
					],
					"description": "Border style for Scratchpad cells."
				},
				"jupyter-cell-tags.jupyterEnhancements.scratchpad.borderWidth": {
					"type": "string",
					"default": "2px",
					"description": "Border width for Scratchpad cells."
				},
				"jupyter-cell-tags.jupyterEnhancements.scratchpad.backgroundColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#FFFFFF0D",
					"description": "Optional background color for Scratchpad cells."
				},
				"jupyter-cell-tags.gitDiff.modifiedCellColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#FFA500",
					"description": "Left border color for cells modified since the selected git commit."
				},
				"jupyter-cell-tags.gitDiff.addedCellColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#4CAF50",
					"description": "Left border color for cells added since the selected git commit."
				},
				"jupyter-cell-tags.gitDiff.borderWidth": {
					"type": "string",
					"default": "4px",
					"description": "Width of the left border indicator on changed cells."
				},
				"jupyter-cell-tags.gitDiff.borderStyle": {
					"type": "string",
					"default": "solid",
					"enum": [
						"solid",
						"dashed",
						"dotted",
						"double"
					],
					"description": "Style of the left border indicator on changed cells."
				},
				"jupyter-cell-tags.gitDiff.modifiedCellBackgroundColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#FFA50015",
					"description": "Subtle background tint for cells modified since the selected git commit."
				},
				"jupyter-cell-tags.gitDiff.addedCellBackgroundColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#4CAF5015",
					"description": "Subtle background tint for cells added since the selected git commit."
				},
				"jupyter-cell-tags.scrollbarDecorators.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable/disable scrollbar decorators showing tag locations in the notebook. When a tag is selected in the All Notebook Tags view, the decorators will be emphasized and flash."
				}
			}
		},
		"commands": [
			{
				"command": "jupyter-cell-tags.removeTag",
				"title": "🏷️➖ Remove Cell Tag",
				"icon": "$(close)"
			},
			{
				"command": "jupyter-cell-tags.addTag",
				"title": "🏷️➕ Add Tag to Cell",
				"icon": "$(add)",
				"when": "jupyter-cell-tags.singleCellSelected"
			},
			{
				"command": "jupyter-cell-tags.addTagsToSelectedCells",
				"title": "🏷️➕🗂️ Add Tags to Selected Cells",
				"icon": "$(add)",
				"when": "jupyter-cell-tags.multipleCellsSelected"
			},
			{
				"command": "jupyter-cell-tags.editTagsInJSON",
				"title": "🗂️ Edit Cell Tags (JSON)",
				"icon": "$(go-to-file)"
			},
			{
				"command": "jupyter-cell-tags.paramaterize",
				"title": "Mark Cell as Parameters"
			},
			{
				"command": "jupyter-cell-tags.showAllNotebookTags",
				"title": "🎛️Show All Notebook Tags View",
				"category": "Jupyter"
			},
			{
				"command": "jupyter-cell-tags.executeRunGroup",
				"title": "🏷️▶️ Execute Tag Run Group",
				"category": "Jupyter"
			},
			{
				"command": "jupyter-cell-tags.executeRunCell",
				"title": "▶️ Run Cell",
				"icon": "$(play)",
				"category": "Jupyter"
			},
			{
				"command": "jupyter-cell-tags.refreshEntry",
				"title": "Refresh",
				"icon": {
					"light": "resources/light/refresh.svg",
					"dark": "resources/dark/refresh.svg"
				}
			},
			{
				"command": "jupyter-cell-tags.runTag",
				"title": "Run Tag",
				"icon": "$(run-all)",
				"category": "Jupyter"
			},
			{
				"command": "jupyter-cell-tags.deleteCellsUnderHeading",
				"title": "Delete Cells Under Heading"
			},
			{
				"command": "jupyter-cell-tags.selectCellsUnderHeading",
				"title": "📑🗹🖍️👶🗷 Select Cells Under Heading"
			},
			{
				"command": "jupyter-cell-tags.increaseSelectionHeadingDepth",
				"title": "📑🗹🡾⤵ Increase Selected Cells Header Depth"
			},
			{
				"command": "jupyter-cell-tags.decreaseSelectionHeadingDepth",
				"title": "📑🗹🡭⤴ Decrease Selected Cells Header Depth"
			},
			{
				"command": "jupyter-cell-tags.listKernels",
				"title": "Execute code against a Python Kernel",
				"category": "Jupyter Kernel API"
			},
			{
				"command": "jupyter-cell-tags.selectAllChildCells",
				"title": "Select All Child Cells",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.listExecutedNotebookCells",
				"title": "Show the previously executed notebook cells in the current jupyter notebook",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.createAndAddTagToAllExecutedCells",
				"title": "🏷️➕🏃‍♂️▶️ Create and add Tag to all Executed Cells",
				"icon": "$(add)",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.selectAllCellsUnderTag",
				"title": "Select All Cells Under Tag",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.customOutline.selectCell",
				"title": "Notebook Outline: Select Cell",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.customOutline.selectAllChildCells",
				"title": "Notebook Outline: Select All Child Cells",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.customOutline.deleteCellsUnderHeading",
				"title": "Notebook Outline: Delete Cells Under Heading",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.changeSortOrder",
				"title": "Change Tag Sort Order",
				"icon": "$(sort-precedence)",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.setTagPriority",
				"title": "Set Tag Priority",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.setTagColor",
				"title": "Set Tag Color",
				"icon": "$(symbol-color)",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.clearTagColor",
				"title": "Clear Tag Color",
				"icon": "$(close)",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.renameTag",
				"title": "Rename Tag",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.removeTagFromAllCells",
				"title": "🏷️➖ Remove Tag from All Notebook Cells",
				"icon": "$(close)"
			},
			{
				"command": "jupyter-cell-tags.navigateUpToPreviousErrorCell",
				"title": "⬆️❌ Navigate Up to Previous Error Cell",
				"icon": "$(arrow-up)",
				"when": "config.jupyter-cell-tags.enableErrorNavigation"
			},
			{
				"command": "jupyter-cell-tags.navigateDownToNextErrorCell",
				"title": "⬇️❌ Navigate Down to Next Error Cell",
				"icon": "$(arrow-down)",
				"when": "config.jupyter-cell-tags.enableErrorNavigation"
			},
			{
				"command": "jupyter-cell-tags.navigateToPreviousExecutedCell",
				"title": "⬆️▶️ Navigate to Previous Executed Cell",
				"icon": "$(arrow-up)",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.navigateToNextExecutedCell",
				"title": "⬇️▶️ Navigate to Next Executed Cell",
				"icon": "$(arrow-down)",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.addJumpback",
				"title": "🔖↩️➕ Add Jumpback",
				"icon": "$(bookmark)",
				"when": "config.jupyter-cell-tags.enableJumpbacks"
			},
			{
				"command": "jupyter-cell-tags.removeJumpback",
				"title": "🔖↩️➖ $(bookmark) Remove Jumpback",
				"when": "config.jupyter-cell-tags.enableJumpbacks"
			},
			{
				"command": "jupyter-cell-tags.showAllNotebookJumpbacks",
				"title": "🎛️Show All Notebook Jumpbacks View",
				"category": "Jupyter",
				"when": "config.jupyter-cell-tags.enableJumpbacks"
			},
			{
				"command": "jupyter-cell-tags.openJumpback",
				"title": "🔖↩️▶ Open Jumpback",
				"category": "Jupyter",
				"when": "config.jupyter-cell-tags.enableJumpbacks"
			},
			{
				"command": "jupyter-cell-tags.refreshJumpbacks",
				"title": "🔖↩️🗘 Refresh Jumpbacks",
				"icon": "$(refresh)",
				"category": "Jupyter",
				"when": "config.jupyter-cell-tags.enableJumpbacks"
			},
			{
				"command": "jupyter-cell-tags.exportTags",
				"title": "Jupyter: Export tags for notebook..",
				"icon": "$(file-code)",
				"category": "Jupyter"
			},
			{
				"command": "jupyter-cell-tags.importTags",
				"title": "Jupyter: Import Cell Tags from JSON",
				"icon": "$(go-to-file)",
				"category": "Jupyter"
			},
			{
				"command": "jupyter-cell-tags.exportExecutedCodeToPython",
				"title": "Jupyter: Export executed code to Python file...",
				"icon": "$(file-code)",
				"category": "Jupyter"
			},
			{
				"command": "jupyter-cell-tags.showCustomNotebookOutline",
				"title": "Show Custom Notebook Outline",
				"category": "Jupyter Cell Tags"
			},
			{
				"command": "jupyter-cell-tags.customOutline.filter",
